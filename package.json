{
  "name": "@yfridelance/kern",
  "version": "0.10.0",
  "keywords": [
    "web-components",
    "stencil",
    "custom-elements",
    "design-system",
    "dark-mode",
    "angular"
  ],
  "homepage": "https://yfridelance.github.io/kern/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yfridelance/kern.git"
  },
  "bugs": {
    "url": "https://github.com/yfridelance/kern/issues"
  },
  "description": "Kern – dark-first web components for device management, monitoring, network and smart home tools",
  "license": "MIT",
  "type": "module",
  "main": "dist/index.cjs.js",
  "module": "dist/index.js",
  "types": "dist/types/index.d.ts",
  "collection": "dist/collection/collection-manifest.json",
  "collection:main": "dist/collection/index.js",
  "unpkg": "dist/kern/kern.esm.js",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs.js"
    },
    "./loader": {
      "types": "./loader/index.d.ts",
      "import": "./loader/index.js",
      "require": "./loader/index.cjs.js"
    },
    "./components": {
      "types": "./dist/components/index.d.ts",
      "import": "./dist/components/index.js"
    },
    "./components/*.js": {
      "types": "./dist/components/*.d.ts",
      "import": "./dist/components/*.js"
    },
    "./components/*": {
      "types": "./dist/components/*.d.ts",
      "import": "./dist/components/*.js"
    },
    "./kern.css": "./dist/kern/kern.css",
    "./tokens.json": "./tokens/tokens.json"
  },
  "files": [
    "dist/",
    "loader/",
    "tokens/",
    "angular/src/"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "tokens": "node scripts/build-tokens.mjs",
    "brands": "node scripts/build-brands.mjs",
    "flags": "node scripts/build-flags.mjs",
    "build": "npm run tokens && stencil build",
    "start": "npm run tokens && stencil build --dev --watch --serve",
    "test": "npm run tokens && stencil test --spec",
    "generate": "stencil generate",
    "docs": "npm run build && node scripts/build-docs.mjs",
    "docs:serve": "node scripts/serve-docs.mjs",
    "e2e": "npm run build && playwright test"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@stencil/angular-output-target": "1.5.0",
    "@stencil/core": "4.45.2",
    "@types/jest": "29.5.14",
    "flag-icons": "7.5.0",
    "jest": "29.7.0",
    "jest-cli": "29.7.0",
    "simple-icons": "16.35.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
